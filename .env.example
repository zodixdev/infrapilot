# Local development settings for docker compose (deploy/compose). Copy via `make secrets`,
# which fills every *_PASSWORD / *_SECRET with a random value. Never commit .env.
COMPOSE_PROJECT_NAME=infrapilot

# core profile
POSTGRES_USER=infrapilot
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# 8180 on purpose: 8080 is the default of most local services and of our own api-gateway.
KEYCLOAK_PORT=8180

# obs profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
LOKI_PORT=3100
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

# Per-service databases provisioned on first start (comma-separated service names; empty until M02).
INFRAPILOT_SERVICES=
INFRAPILOT_SERVICE_DB_PASSWORD=

# Redis requires a password (core profile).
REDIS_PASSWORD=

# Host interfaces for published ports. Keep 127.0.0.1 locally; CI opens only OTLP to the docker bridge.
BIND_ADDR=127.0.0.1
OTLP_BIND_ADDR=127.0.0.1
